# LinkedIn credentials are optional when using an already logged-in Chrome session.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Application profile
APPLICANT_NAME=
EMAIL=
PHONE=
YEARS_OF_EXPERIENCE=0
RESUME_PATH=resume/resume.pdf

# Automation
# Active analysis/selection currently use fixed values of 70% and 15 applications.
# These config keys are not yet wired into those active stages.
MIN_MATCH_SCORE=70
DAILY_APPLICATION_LIMIT=15
MAX_JOBS=30
AUTO_SUBMIT=false
DRY_RUN=false
UNKNOWN_QUESTIONS_POLICY=SKIP
# Search/details read this value; easy_apply.py currently uses localhost:9222 directly.
CHROME_CDP_URL=http://127.0.0.1:9222
